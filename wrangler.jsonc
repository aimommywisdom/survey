{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mwform",
  "account_id": "86e28a4ac02bab6c0599d99f50afb5f1",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-03-25",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  // 資料層：Cloudflare D1（SQLite）。schema 在 migrations/d1/；本機 next dev 自動用 .wrangler/state 的本機 D1。
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mwform",
      "database_id": "55924f66-4886-42ff-83b9-c63edcc7f793",
      "migrations_dir": "migrations/d1"
    }
  ],
  "routes": [
    { "pattern": "survey.aimommywisdom.com", "custom_domain": true }
  ]
  // 敏感值用 `npx wrangler secret put <NAME>` 設定（不寫進檔案）：
  //   ADMIN_PASSWORD / SESSION_SECRET / SETTINGS_ENC_KEY / CRON_SECRET
  // 2026-11 搬到 D1 後，SUPABASE_SERVICE_ROLE_KEY / NEXT_PUBLIC_SUPABASE_ANON_KEY 這兩個 secret 已不再使用。
}
