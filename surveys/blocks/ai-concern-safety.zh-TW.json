            { "value": "replaced",    "label": "怕自己的工作被取代" },
            { "value": "more_work",   "label": "怕反而變得更麻煩" },
            { "value": "no_support",  "label": "怕沒人可以問" },
            { "value": "none",        "label": "不太擔心", "exclusive": true }
          ]
        },
        {
          "id": "q_training_willing",
          "type": "single",
          "label": "如果安排 2 小時的教育訓練，你願意參加嗎？",
