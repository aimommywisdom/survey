  "sections": [
    {
      "id": "sec_basic",
      "title": "關於你",
      "description": "本問卷不記名，以下資料僅供分組統計使用。",
      "questions": [
        {
          "id": "q_dept",
          "type": "single",
          "label": "你的服務單位是？",
          "required": true,
          "options": [
            { "value": "ops_a", "label": "第一線服務單位 A" },
            { "value": "ops_b", "label": "第一線服務單位 B" },
            { "value": "admin", "label": "行政／會計／人資" },
            { "value": "other", "label": "其他", "allow_text": true }
          ]
        },
        {
          "id": "q_role",
          "type": "single",
          "label": "你的職務類別是？",
          "required": true,
          "options": [
            { "value": "manager",       "label": "組長以上主管",  "meta": { "role_group": "admin_mgmt" } },
            { "value": "admin_staff",   "label": "行政人員",      "meta": { "role_group": "admin_mgmt" } },
            { "value": "accountant",    "label": "會計／人資",    "meta": { "role_group": "admin_mgmt" } },
            { "value": "social_worker", "label": "社工",          "meta": { "role_group": "professional" } },
            { "value": "educator",      "label": "教保員",        "meta": { "role_group": "professional" } },
            { "value": "caregiver",     "label": "照服員",        "meta": { "role_group": "frontline" } },
            { "value": "driver",        "label": "司機",          "meta": { "role_group": "frontline" } },
            { "value": "field_worker",  "label": "現場作業人員",  "meta": { "role_group": "frontline" } },
            { "value": "other_role",    "label": "其他", "allow_text": true, "meta": { "role_group": "frontline" } }
          ]
        },
        {
          "id": "q_tenure",
          "type": "single",
          "label": "在本機構服務多久了？",
          "required": true,
          "options": [
            { "value": "lt1",  "label": "未滿 1 年" },
            { "value": "1to3", "label": "1–3 年" },
            { "value": "3to5", "label": "3–5 年" },
            { "value": "gt5",  "label": "5 年以上" }
          ]
        },
        {
          "id": "q_device",
          "type": "multi",
          "label": "工作時你主要使用哪些設備？（可複選）",
          "required": true,
          "options": [
            { "value": "desktop", "label": "辦公室桌上型電腦" },
            { "value": "laptop",  "label": "筆記型電腦" },
            { "value": "tablet",  "label": "平板" },
            { "value": "phone",   "label": "手機" },
            { "value": "none",    "label": "工作中幾乎不用電腦或手機", "exclusive": true }
          ]
        }
      ]
    }
  ]
