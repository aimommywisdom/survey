# MWForm 環境變數範本 —— 複製成 .env.local 後填入真實值（.env.local 已被 gitignore）
# 2026-11 起資料層為 Cloudflare D1（wrangler.jsonc 的 DB 綁定），本機 next dev 自動用 .wrangler/state 的本機 D1，
# 不需要任何資料庫 key。正式環境這些值用 `npx wrangler secret put <NAME>` 設定。

# 後台登入密碼
ADMIN_PASSWORD=
# 後台 session cookie 的 HMAC 簽章金鑰（任意長隨機字串）
SESSION_SECRET=
# 加密 LLM API key 用的 AES-256 金鑰（32 bytes 的 base64：openssl rand -base64 32）
SETTINGS_ENC_KEY=
# /api/cron/purge 的 Bearer token（cf-scheduler 用）
CRON_SECRET=

# （僅搬遷期間需要）scripts/migrate-from-supabase.mjs 從舊 Supabase 讀資料用；切換完成 30 天後可刪
# NEXT_PUBLIC_SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
